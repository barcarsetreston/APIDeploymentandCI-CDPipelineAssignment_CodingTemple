# Copy this file to .env for local development (the real .env is gitignored
# and never pushed to GitHub). On Render, set these same names as
# environment variables in the Web Service's Environment tab instead.

# Tells config.py which class to load. Leave unset (or "development") for
# local SQLite dev; Render's env var should be set to "production".
FLASK_CONFIG=development

# Only needed once you're pointed at a real database instead of the default
# local SQLite file. Locally this can be MySQL/Postgres/etc; on Render this
# should be the "External Database URL" from your Render Postgres instance.
# DATABASE_URL=postgresql://user:password@host/dbname

# Used to sign sessions/tokens. Falls back to an insecure dev default if
# unset, so make sure a real random value is set on Render.
SECRET_KEY=dev-secret-key-change-me
